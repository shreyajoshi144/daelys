# Copy to .env and fill in. Never commit .env.

# --- Host ports (change if another local stack already uses them) ---
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000

# --- Postgres ---
# Superuser password for the local postgres container (local dev only).
POSTGRES_PASSWORD=change-me-local-superuser
# Owner/migration connection (runs alembic; owns the tables). Host-side URL; compose overrides the host.
DATABASE_URL=postgresql+asyncpg://postgres:change-me-local-superuser@localhost:5432/daelys
# Password the migration assigns to the non-superuser app role `daelys_app`.
DAELYS_APP_PASSWORD=change-me-app-role
# Connection used by the API, worker, seed and replay. Must be the daelys_app role, never a superuser.
APP_DATABASE_URL=postgresql+asyncpg://daelys_app:change-me-app-role@localhost:5432/daelys

# --- Redis (arq jobs, login rate limit) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# HS256 signing secret, at least 32 chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Access token lifetime in minutes.
JWT_TTL_MINUTES=60
# Max login attempts per minute per client IP and per account.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Mark the web session cookie Secure (true in any deployment served over HTTPS).
COOKIE_SECURE=false

# --- Seed ---
# Password given to every seeded demo user (local/demo only).
SEED_USER_PASSWORD=
# GitHub App installation id to link to the Tiffin Box tenant (optional; enables webhooks for it).
SEED_GITHUB_INSTALLATION_ID=

# --- GitHub App ---
# Webhook secret configured on the GitHub App. Webhooks are rejected (503) while empty.
GITHUB_WEBHOOK_SECRET=
# Numeric GitHub App id (for REST backfill).
GITHUB_APP_ID=
# Path to the App's private key PEM (for REST backfill). Keep it outside the repo.
GITHUB_APP_PRIVATE_KEY_PATH=
# GitHub REST base URL (override only for GitHub Enterprise).
GITHUB_API_URL=https://api.github.com

# --- LLM (Sprint 2) ---
# Anthropic API key. Planning endpoints and the bench return 503 not_configured while empty.
ANTHROPIC_API_KEY=
# API base URL (override only for a proxy/gateway).
ANTHROPIC_API_BASE=https://api.anthropic.com
# Ordered provider:model fallback chain; later entries serve on timeout/429/5xx/refusal of earlier ones.
LLM_ROUTES=anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5
# Per-call timeout in seconds.
LLM_TIMEOUT_SECONDS=180
# Max planning calls per tenant per minute.
LLM_RATE_LIMIT_PER_MINUTE=20

# --- Embeddings (Sprint 2) ---
# Voyage AI key for 1024-dim chunk embeddings. Empty = chunks stored without embeddings (reported per upload).
VOYAGE_API_KEY=
# Voyage embedding model (must output 1024 dimensions).
EMBEDDING_MODEL=voyage-3.5

# --- Meetings (Sprint 5) ---
# Optional. Path to the Notiv repository (host runs); its transcription (faster-whisper) is used as a library.
# Empty = audio upload answers 503 not_configured. Labelled transcripts work without it.
NOTIV_PATH=
# Optional. Host folder of the Notiv repo, mounted read-only into the containers at /notiv.
NOTIV_HOST_PATH=
# Whisper model Notiv loads (read by Notiv): tiny, base, small, medium...
NOTIV_WHISPER_MODEL=small

# --- Email for the notify action (Sprint 4) ---
# SMTP server. Locally this is Mailpit (started by `make up`); empty = notify returns 503 not_configured.
SMTP_HOST=localhost
# SMTP port (host side; compose overrides it for containers).
SMTP_PORT=1025
# Sender address for notifications.
SMTP_FROM=daelys@localhost
# Host ports for Mailpit's SMTP and web UI (http://localhost:<MAILPIT_UI_HOST_PORT>).
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# --- Logging ---
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
